# Site settings. Run 00-common/plan.py after a change.
# Use plain values. This file is read by bash and by plan.py.
# Do not change these values on a running platform. Install again instead.

# Prefix for Docker, network, registry, label and image names.
PLATFORM_NAME=vks
# All programs and data go below this folder.
PLATFORM_ROOT=/data/vks
# DNS zone of dnscore.
DOMAIN=ubuntu.local
